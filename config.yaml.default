# config.yaml.default — reference template for Pueo configuration
# Run setup.sh to generate config.yaml interactively, or copy this file:
#   cp config.yaml.default config.yaml
# config.yaml is gitignored and never committed.

home_assistant:
  known_version: ""              # Populated by setup.sh; Pueo warns at startup if HA has updated
  host: "homeassistant.local"        # IP address or mDNS hostname of your HA server
  user: "root"                        # SSH username (root for the Terminal & SSH App)
  ssh_key_path: "~/.ssh/id_ed25519"  # Local path to the SSH private key
  api_token: ""                        # HA long-lived access token — create at: Profile → Security → Long-Lived Access Tokens
  api_port: 8123                       # Port for the HA REST API
  config_path: "/config/configuration.yaml"  # Path to configuration.yaml on the HA host

ollama:
  model: "qwen3:8b"                   # Primary model for config analysis and repair
                                      # qwen3 preferred over qwen2.5-coder: better tool-call compliance
                                      # Run `ollama pull qwen3:8b` (or set model_auto: true to auto-select)
  model_auto: false                   # If true, select the best-fit model for this hardware at startup
  endpoint: "http://localhost:11434"  # Ollama API endpoint (default local)
  # embed_model: "nomic-embed-text"   # Embedding model for RAG knowledge store (requires `ollama pull nomic-embed-text`)

llm:
  provider: "local"  # "local" | "cloud" | "both"
                     # local: Ollama only (default, no WAN for inference)
                     # cloud: Anthropic API as primary LLM
                     # both: Ollama for autonomous cycles + Claude available for approved escalation
                     # Note: "cloud" and "both" require ANTHROPIC_API_KEY env var — never put it here

cloud:
  model: "claude-sonnet-5"             # Claude model for cloud/both modes
  max_cost_per_incident_usd: 0.50      # Hard cap per escalation incident
  max_daily_spend_usd: 5.00            # Rolling 24-hour spend cap
  # ANTHROPIC_API_KEY must be exported in ~/.zshenv — never written here

netalertx:
  setup_desired: false                        # set true to have Pueo install and configure NetAlertX automatically
  deployment: "auto"                          # auto | addon | docker — how NetAlertX is deployed
  host: ""                                    # NetAlertX host (default: same as home_assistant.host)
  api_port: 20212                             # NetAlertX REST API port
  api_token: ""                               # Generated after first install: NetAlertX UI → Settings → Main Settings → API Key
  ssh_host: ""                                # SSH host for NetAlertX (default: same as home_assistant.host)
  ssh_user: ""                                # SSH user for NetAlertX (default: same as home_assistant.user)
  ssh_key_path: ""                            # SSH key for NetAlertX (default: same as home_assistant.ssh_key_path)
  addon_repository_url: "https://github.com/alexbelgium/hassio-addons"  # HA Supervisor add-on repo (netalertx_fa slug)
  addon_slug: ""                              # Leave blank to auto-resolve from Supervisor store
  scan_interface: ""                          # Network interface for scanning (blank = auto-detect)
  auto_generated_name_patterns:               # Regex patterns identifying auto-generated device names
    - "^unknown-"
    - "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$"
  max_scan_age_minutes: 20                    # Alert if no scan completed within this window
  mqtt_subscribe: true                        # Subscribe to NetAlertX MQTT device presence events
  mqtt_user: ""                               # MQTT username — create HA user: Settings → People → Users → Add User
  mqtt_password: ""                           # MQTT password — enable auth in: Settings → Apps → Mosquitto broker → Configuration
  log_container_name: "netalertx"            # Docker container name (Docker deployments only)
  max_db_history_rows: 100000                 # Trigger DB cleanup above this row count
  deploy_target: "ha"                         # Install target: ha (HA add-on) | docker (separate machine)
  docker_host: ""                             # IP/hostname of the separate Docker machine
  docker_ssh_user: ""                         # SSH user for Docker host (blank = same as HA user)
  docker_ssh_key_path: ""                     # SSH key for Docker host (blank = same as HA key)
  docker_config_path: "/opt/netalertx/config" # Config volume path on Docker host
  docker_image: "ghcr.io/netalertx/netalertx:latest"  # Docker image to pull and run
  docker_min_disk_gb: 5.0                     # Abort Docker install if host has less free space (GB)
  severity_confidence_threshold: 0.9          # Minimum confidence score to classify as HIGH severity

agent:
  db_path: "ha_agent_state.db"       # Local SQLite file for state and backup history
  log_confidence_threshold: 0.7      # Minimum AI confidence score to trigger autonomous repair
  self_healing_enabled: true         # Set to false to run in diagnostic-only mode
  ssh_retry_attempts: 3              # Max SSH connection retries before giving up (0 = infinite)
  ssh_retry_base_delay: 2.0          # Base delay in seconds for SSH retry exponential backoff
  debounce_window_seconds: 30        # Suppress repeated repair triggers within this window
  repair_cooldown_seconds: 300       # Pause after a repair before re-arming the monitor
  max_repairs_per_hour: 10           # Hard cap on autonomous repair attempts per hour
  log_level: "INFO"                  # Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
  log_file: "pueo.log"               # Path to the structured JSON log file
  max_prompt_tokens: 7000            # Maximum tokens sent to Ollama per request (8k context minus headroom)
  notifier: "file"                   # approval notification backend: "file", "ntfy", or "webhook"
  notify_url: ""                     # URL for ntfy topic or webhook endpoint (unused for "file" notifier)
  notify_watch_dir: "hitl/"          # Directory watched by FileNotifier for .approved/.rejected signals
  autonomy_level: 2                  # 1=report-only · 2=suggest(approve all) · 3=guided(auto-LOW) · 4=autonomous(auto-LOW/MED/HIGH)
  dashboard_port: 8080               # Port for the web dashboard (python main.py --mode dashboard)
  timeline_page_size: 25             # Number of events shown per page on the Timeline tab
  resource_poll_interval_seconds: 300  # How often to poll HA disk/memory (seconds)
  # disk_usage_poll_interval_seconds: 300  # How often to scan per-path disk usage (seconds)
  ha_disk_warn_gb: 5.0               # Send an approval card when HA disk free drops below this value (GB)
  ha_disk_critical_gb: 3.0           # Block backup creation and escalate to CRITICAL below this value (GB).
                                     # Must stay well above 1.0: the HA Supervisor independently hard-blocks ALL
                                     # operations (including backup creation) when free space < 1 GB. The default
                                     # of 3.0 GB leaves a 2 GB write buffer so a typical 1-2 GB backup can
                                     # complete without hitting the Supervisor's block. Raise this value if your
                                     # HA backups are consistently larger than 2 GB.
  ha_mem_warn_mb: 256                # Send an approval card when HA memory available drops below this value (MB)
  backup_offload_enabled: true       # SFTP-pull each backup .tar to Pueo's local machine after creation
  backup_local_dir: "./backups/"     # Local directory for offloaded backup files
  backup_retain_on_ha: 2             # Maximum backups to keep on HA; oldest confirmed-local ones are deleted
  backup_retain_local_days: 30       # Purge local .tar copies older than this many days
  disk_recovery_auto_enabled: true   # Run safe recovery steps automatically when disk is critical
  disk_recovery_recorder_keep_days: 30  # Days of history to keep when auto-purging the recorder DB
  disk_recovery_journal_max_mb: 200  # Target size (MB) for systemd journal after auto-vacuum
  pueo_archive_dir: "./archives/"      # Root directory for Pueo-archived HA data (logs, journal dumps)
  archive_ha_log_enabled: true         # Copy HA log to Pueo before truncating on disk-critical
  archive_journal_enabled: false       # Dump systemd journal to Pueo before vacuuming (off by default: noisy)
  pueo_archive_max_gb: 2.0             # Max local storage for archived HA logs and journal dumps (GB)
  pueo_local_max_gb: 20.0              # Soft-warn threshold for Pueo's total local storage footprint (GB)
  update_check_interval_hours: 6      # How often to poll for HA updates (0 = off; requires api_token)
  # update_notify_on_available: true  # Send an approval notification when any update entity flips to on
  # update_release_notes_cache_dir: ".cache/ha_release_notes/"  # Local cache for fetched HA release notes
  notification_poll_interval_minutes: 5  # How often to poll for HA persistent notifications (requires api_token)
  ha_repair_poll_interval_minutes: 5   # How often to poll for HA repair issues (0 = off; requires api_token)
  log_triage_cooldown_hours: 4         # Min hours between approval cards for the same recurring log error (persistent dedup)
  rejection_cooldown_hours: 24         # Hours a card is suppressed after the user rejects it (doubles on repeat rejections)
  known_issue_reminder_days: 7         # Days before a Known Issue generates a reminder card
  # notification_enrich_auth_failures: true  # Enrich http_login notifications with IP/device context
  agent_max_tool_calls: 30            # Hard cap on tool invocations per agent loop run
  agent_max_wall_seconds: 300.0       # Wall-clock timeout for the entire agent loop (seconds)
  agent_max_extension_calls: 15       # Max additional calls the LLM may request per limit-review
  agent_max_total_calls: 60           # Absolute ceiling across base budget + all extensions
  # ha_profile_refresh_hours: 24       # How often to rebuild the HA environment profile (integrations, versions)
  # chat_memory_top_k: 10             # Max memory entries returned per recall() call
  # chat_allow_tool_registration: false  # Allow agent to write and register new Python tools (sandboxed + requires approval)
  # chromadb_path: "./chromadb/"      # Local ChromaDB vector store directory (RAG knowledge layer)
  # rag_top_k: 5                      # Number of knowledge chunks returned per query_knowledge call
  # rag_ha_versions_to_fetch: 12      # How many recent HA releases to fetch from GitHub on rag-refresh
  # rag_hacs_cache_dir: ".cache/hacs_changelogs/"  # Local cache for fetched HACS integration changelogs
  # rag_ha_docs_cache_dir: ".cache/ha_docs/"       # Local cache for fetched HA integration documentation
  # ha_source_cache_dir: ".cache/ha_source/"       # Local cache for HA component source files (fetch_ha_docs tool)
  # federated_cases_repo: ""  # GitHub repo for community case library (e.g. "owner/pueo-cases"); enables episode submission and ingest
  # allow_diagnostic_wan: true       # Allow fetch_url tool to make outbound HTTP GET requests for diagnostic verification
  # diagnostic_wan_timeout_seconds: 60  # Timeout for fetch_url calls (seconds)
  # case_ingest_cache_dir: ".cache/case_ingest/"  # Local cache for community case ingest state (last-ingest timestamp)
