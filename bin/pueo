#!/usr/bin/env bash
# pueo — start the Pueo supervisor in the background.
# Logs go to pueo.log via Python's file handler; terminal output is suppressed.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
PYTHON="$PROJECT_DIR/.venv/bin/python"
LOG="$PROJECT_DIR/pueo.log"
PID_FILE="$PROJECT_DIR/pueo.pid"

if [ ! -f "$PYTHON" ]; then
    echo "Error: .venv not found. Run setup.sh first." >&2
    exit 1
fi

if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    echo "Pueo is already running (PID $(cat "$PID_FILE")). Log: $LOG" >&2
    exit 1
fi

cd "$PROJECT_DIR"
"$PYTHON" main.py > /dev/null 2>&1 &
echo $! > "$PID_FILE"
echo "Pueo started (PID $!). Log: $LOG"
