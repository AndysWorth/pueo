#!/usr/bin/env bash
# pueo — manage the Pueo supervisor process.
# Usage: pueo [start|stop|status] [--config FILE]   (default: start)
#        pueo --mode MODE [--config FILE] [--since DATE]
set -euo pipefail

# Resolve symlink so this works whether invoked directly or via /usr/local/bin symlink.
_self="${BASH_SOURCE[0]}"
[ -L "$_self" ] && _self="$(readlink "$_self")"
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
PYTHON="$PROJECT_DIR/.venv/bin/python"

# Resolve platform-appropriate directories via paths.py; fall back if venv is absent.
PUEO_LOG_DIR=$("$PYTHON" -c "import sys; sys.path.insert(0,'$PROJECT_DIR'); import paths; print(paths.get_dirs().log_dir)" 2>/dev/null || echo "${HOME}/Library/Logs/Pueo")
PUEO_STATE_DIR=$("$PYTHON" -c "import sys; sys.path.insert(0,'$PROJECT_DIR'); import paths; print(paths.get_dirs().state_dir)" 2>/dev/null || echo "${HOME}/Library/Application Support/Pueo")
mkdir -p "$PUEO_LOG_DIR" "$PUEO_STATE_DIR"

LOG="$PUEO_LOG_DIR/pueo.log"
ERRLOG="$PUEO_LOG_DIR/pueo-stderr.log"
PID_FILE="$PUEO_STATE_DIR/pueo.pid"

CMD="${1:-start}"

_running() {
    [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

case "$CMD" in
    start)
        if [[ $# -gt 0 ]]; then shift; fi  # remove "start" from positional args if it was explicit
        EXTRA_ARGS=("$@")  # capture remaining flags, e.g. --config /path/config.yaml
        if [ ! -f "$PYTHON" ]; then
            echo "Error: .venv not found. Run setup.sh first." >&2
            exit 1
        fi
        if _running; then
            echo "Pueo is already running (PID $(cat "$PID_FILE")). Log: $LOG" >&2
            exit 1
        fi
        # Source user env so the background process inherits secrets like ANTHROPIC_API_KEY.
        # shellcheck disable=SC1091
        [ -f "$HOME/.zshenv" ] && source "$HOME/.zshenv"
        _CONFIG_PATH=$("$PYTHON" -c "import sys; sys.path.insert(0,'$PROJECT_DIR'); import paths; print(paths.get_dirs().config_dir / 'config.yaml')" 2>/dev/null || echo "$PROJECT_DIR/config.yaml")
        if grep -q "LLM_PROVIDER.*both\|LLM_PROVIDER.*cloud" "$_CONFIG_PATH" 2>/dev/null; then
            if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
                echo "Error: ANTHROPIC_API_KEY is not set. Add it to ~/.zshenv and retry." >&2
                exit 1
            fi
        fi
        "$PYTHON" "$PROJECT_DIR/main.py" "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}" >> "$LOG" 2>> "$ERRLOG" &
        echo $! > "$PID_FILE"
        _PORT=$("$PYTHON" -c "import sys; sys.path.insert(0,'$PROJECT_DIR'); import config; print(config.DASHBOARD_PORT)" 2>/dev/null || echo "8080")
        echo "Pueo started (PID $!). Dashboard: http://127.0.0.1:$_PORT  Log: $LOG"
        ;;
    stop)
        if ! _running; then
            echo "Pueo is not running." >&2
            [ -f "$PID_FILE" ] && rm "$PID_FILE"
            exit 0
        fi
        PID="$(cat "$PID_FILE")"
        kill "$PID"
        rm "$PID_FILE"
        echo "Pueo stopped (PID $PID)."
        ;;
    status)
        if _running; then
            echo "Pueo is running (PID $(cat "$PID_FILE"))  Log: $LOG"
        else
            echo "Pueo is not running."
            [ -f "$PID_FILE" ] && rm "$PID_FILE"
        fi
        ;;
    *)
        # Passthrough: pueo --mode X [--config Y] → python main.py --mode X [--config Y]
        if [ ! -f "$PYTHON" ]; then
            echo "Error: .venv not found. Run setup.sh first." >&2
            exit 1
        fi
        # shellcheck disable=SC1091
        [ -f "$HOME/.zshenv" ] && source "$HOME/.zshenv"
        exec "$PYTHON" "$PROJECT_DIR/main.py" "$@"
        ;;
esac
