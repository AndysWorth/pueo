# docker-compose.yml.example — reference template with placeholder values
#
# Run ./setup.sh (choose "docker" or "both") to generate a fully configured
# docker-compose.yml with your SSH key path and timezone filled in.
# To configure manually: copy this file to docker-compose.yml and set
# SSH_KEY_PATH and TZ (or edit the values inline).
#
# Quick start (after setup.sh):
#   docker compose up -d
#   docker compose logs -f pueo

services:
  pueo:
    build: .
    container_name: pueo-agent
    restart: unless-stopped
    network_mode: "host"
    volumes:
      # /config  — bind-mount config.yaml read-only; place config.yaml in a
      #            host directory (e.g. ./config/) and point this mount there.
      #            The file must be at /config/config.yaml inside the container.
      - ./config:/config:ro
      # SSH private key — mounted read-only so asyncssh can connect to HA.
      # Set SSH_KEY_PATH to your actual key path, or edit the path inline.
      - ${SSH_KEY_PATH:-~/.ssh/id_ed25519}:/root/.ssh/id_ed25519:ro
      # /data    — HA backups, archives, ChromaDB.  Named volume: survives
      #            container recreation.
      - pueo-data:/data
      # /state   — SQLite DB, HITL cards, approved user tools, audit records.
      - pueo-state:/state
      # /cache   — HA release-notes, HACS changelogs, ha_source, case_ingest.
      #            Ephemeral-safe: Pueo will re-scrape on next refresh if empty.
      - pueo-cache:/cache
      # /logs    — pueo.log and pueo-stderr.log.  Named volume so logs persist
      #            across restarts without cluttering the image layer.
      - pueo-logs:/logs
    environment:
      - TZ=${TZ:-America/New_York}
      # ANTHROPIC_API_KEY is required only when LLM_PROVIDER=cloud or both.
      # Uncomment and set if you use cloud escalation:
      # - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

volumes:
  pueo-data:
  pueo-state:
  pueo-cache:
  pueo-logs:
