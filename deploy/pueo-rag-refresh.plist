<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS launchd plist — weekly RAG knowledge-base refresh.

  Install via setup.sh (recommended).

  To run immediately:
    launchctl start io.pueo.rag-refresh

  Runs every Sunday at 03:00 local time.
  Reads cached HA release notes and HACS changelogs and upserts them to ChromaDB.
  Placeholders ({{ NAME }}) are substituted at install time by setup.sh.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.pueo.rag-refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{ PYTHON_PATH }}</string>
    <string>{{ PUEO_DIR }}/main.py</string>
    <string>--mode</string>
    <string>rag-refresh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>{{ PUEO_DIR }}</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PUEO_CONFIG_DIR</key>
    <string>{{ PUEO_CONFIG_DIR }}</string>
    <key>PUEO_DATA_DIR</key>
    <string>{{ PUEO_DATA_DIR }}</string>
    <key>PUEO_STATE_DIR</key>
    <string>{{ PUEO_STATE_DIR }}</string>
    <key>PUEO_CACHE_DIR</key>
    <string>{{ PUEO_CACHE_DIR }}</string>
    <key>PUEO_LOG_DIR</key>
    <string>{{ PUEO_LOG_DIR }}</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>{{ PUEO_LOG_DIR }}/pueo-rag-refresh.log</string>

  <key>StandardErrorPath</key>
  <string>{{ PUEO_LOG_DIR }}/pueo-rag-refresh.err</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
